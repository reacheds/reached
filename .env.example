# ==============================================================================
# DISPARE MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Do NOT put actual secrets or tokens into this file.
# 2. Copy this file to `.env` in the root (or per app) for local development:
#    cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Shared across packages/database, apps/bot, apps/web)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (compatible with Supabase, Neon, or local Docker)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dispare_db"

# ------------------------------------------------------------------------------
# 2. DISCORD BOT (apps/bot)
# ------------------------------------------------------------------------------
# Discord Developer Portal -> Your Application -> Bot -> Token
DISCORD_TOKEN="your_discord_bot_token_here"

# Discord Developer Portal -> Your Application -> General Information -> Application ID
DISCORD_CLIENT_ID="123456789012345678"

# Optional: Specific Discord Guild/Server ID for fast slash command development/testing
DISCORD_DEV_GUILD_ID=""

# ------------------------------------------------------------------------------
# 3. WEB & AUTHENTICATION (apps/web)
# ------------------------------------------------------------------------------
# Base URL for the Next.js web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / Auth.js secret key. Generate with: openssl rand -base64 32
AUTH_SECRET="super_secret_generated_key_at_least_32_characters_long"

# Discord OAuth2 Client Secret for user dashboard authentication
# Discord Developer Portal -> Your Application -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET="your_discord_oauth_client_secret_here"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"
